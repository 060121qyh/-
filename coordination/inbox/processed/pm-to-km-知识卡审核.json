  "任务标题": "11张知识卡内容质量审核",
  "任务描述": "现有11张知识卡(data/knowledge-cards/)需要内容质量审核：\n1. 每张卡按10维度评分标准打分\n2. 检查内容准确性（政策引用是否正确、数据是否最新）\n3. 检查四层结构完整性（摘要→考点→详解→溯源）\n4. 对不达标的卡给出具体修正建议\n5. 识别缺失模块（毛泽东思想/地理科技/历史人文）",
  "输入": {
    "参考文件": [
      "data/knowledge-cards/ (11张知识卡)",
      "references/knowledge-card-quality-rules.md (从旧版Skill提取)"
    ]
  },
  "验收标准": [
    "1. 11张知识卡每张都有10维度评分",
    "2. 识别出不达标卡（<55分）并给出修正建议",
    "3. 列出缺失模块（毛泽东思想/地理科技/历史人文）",
    "4. 产出格式规范的审核报告"
  ],
  "10维度评分标准": {
    "字数": {"满分": 10, "要求": "≥2000字"},
    "知识点章节": {"满分": 15, "要求": "≥4个细分知识点"},
    "表格": {"满分": 15, "要求": "≥1个结构化表格"},
    "口诀": {"满分": 15, "要求": "含记忆口诀"},
    "考情分析": {"满分": 10, "要求": "含考情分析"},
    "来源": {"满分": 5, "要求": "标注信息来源"},
    "结构化": {"满分": 5, "要求": "层次清晰"},
    "加粗": {"满分": 5, "要求": "关键概念加粗"},
    "分值关联": {"满分": 10, "要求": "标注考分权重"},
    "例题": {"满分": 10, "要求": "含配套例题"}
  },
  "产出要求": {
    "文件路径": "outputs/KM-知识卡审核报告.md",
    "格式": "Markdown",
    "说明": "逐卡评分+修正建议+缺失模块清单"
  }
}
